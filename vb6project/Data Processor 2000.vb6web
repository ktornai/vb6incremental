{
  "schema": 1,
  "id": "id_mvr47wcg_2j",
  "name": "Data Processor 2000",
  "description": "Incremental game about calculating veryyy big data byte by byte",
  "startup": "Form1",
  "modules": [
    {
      "id": "id_mvr47wcg_2h",
      "name": "Form1",
      "kind": "form",
      "code": "Option Explicit\n\nPrivate Type TBigNumber\n    num As Integer\n    exp As Long\nEnd Type\n\nPrivate Sub AddBigNumbers(ByRef a As TBigNumber, _\n                          ByRef b As TBigNumber, _\n                          ByRef result As TBigNumber)\n    Dim commonExp As Long\n    Dim total As Double\n\n    ' Use the larger exponent as the common exponent.\n    If a.exp >= b.exp Then\n        commonExp = a.exp\n        total = CDbl(a.num) + _\n                CDbl(b.num) / (10# ^ (a.exp - b.exp))\n    Else\n        commonExp = b.exp\n        total = CDbl(a.num) / _\n                (10# ^ (b.exp - a.exp)) + CDbl(b.num)\n    End If\n\n    ' Round to the nearest integer.\n    total = Int(total + 0.5)\n\n    ' Normalize: keep num below 1000.\n    If total >= 1000 Then\n        total = total / 1000\n        commonExp = commonExp + 3\n\n        ' Handle rounding that produces 1000.\n        total = Int(total + 0.5)\n        If total >= 1000 Then\n            total = total / 1000\n            commonExp = commonExp + 3\n        End If\n    End If\n\n    result.num = CInt(total)\n    result.exp = commonExp\n\nEnd Sub\n\n\nPrivate Function BigNumberToString(ByRef n As TBigNumber) As String\n    Dim suffix As String\n\n    If n.num = 0 Then\n        BigNumberToString = \"0\"\n        Exit Function\n    End If\n\n    Select Case n.exp\n        Case Is < 3\n            BigNumberToString = CStr(n.num)\n            Exit Function\n\n        Case 3\n            suffix = \"K\"\n        Case 6\n            suffix = \" million\"\n        Case 9\n            suffix = \" billion\"\n        Case 12\n            suffix = \" trillion\"\n        Case 15\n            suffix = \" quadrillion\"\n        Case 18\n            suffix = \" quintillion\"\n        Case 21\n            suffix = \" sextillion\"\n        Case 24\n            suffix = \" septillion\"\n        Case 27\n            suffix = \" octillion\"\n        Case 30\n            suffix = \" nonillion\"\n        Case 33\n            suffix = \" decillion\"\n        Case 36\n            suffix = \" undecillion\"\n        Case 39\n            suffix = \" duodecillion\"\n        Case 42\n            suffix = \" tredecillion\"\n        Case 45\n            suffix = \" quattuordecillion\"\n        Case 48\n            suffix = \" quindecillion\"\n        Case 51\n            suffix = \" sexdecillion\"\n        Case 54\n            suffix = \" septendecillion\"\n        Case 57\n            suffix = \" octodecillion\"\n        Case 60\n            suffix = \" novemdecillion\"\n        Case 63\n            suffix = \" vigintillion\"\n        Case Else\n            suffix = \"e\" & CStr(n.exp)\n    End Select\n\n    BigNumberToString = CStr(n.num) & suffix\nEnd Function\n\n\nDim score as TBigNumber\nDim bps as TBigNumber\n\nPrivate Sub UpdateScoreAndBPSLabel()\n    Dim scoreStr = BigNumberToString(score)\n    Dim bpsStr = BigNumberToString(bps)\n    \n    lblScore.Caption = scoreStr \n    lblBPS.Caption = bpsStr\nEnd Sub\n\n\nPrivate Sub Form_Load()\n    score.num = 0\n    score.exp = 0    \n\n    bps.num = 100\n    bps.exp = 2\n        \n    UpdateScoreLabel(score)\nEnd Sub\n\nPrivate Sub CommandButton1_Click()\n    Dim res as TBigNumber\n    AddBigNumbers(score, bps, res)\n    score = res\n    UpdateScoreLabel()\nEnd Sub\n",
