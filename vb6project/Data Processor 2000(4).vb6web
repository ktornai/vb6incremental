    {
      "id": "id_mvtynqyn_1j",
      "name": "CBigNumber",
      "kind": "class",
      "code": "Option Explicit\n\nPrivate mDigits As String\nPrivate mFraction As Double\n\nPrivate Sub Class_Initialize()\n    mDigits = \"0\"\n    mFraction = 0#\nEnd Sub\n\nPublic Property Get Value() As String\n    Value = mDigits\nEnd Property\n\nPublic Property Let Value(ByVal s As String)\n    mDigits = Normalize(s)\nEnd Property\n\nPublic Function IsZero() as Boolean\n    IsZero = mDigits = \"0\" And mFraction = 0#\nEnd Function\n\nPublic Sub Add(ByVal Other As CBigNumber)\n    mDigits = AddAbs(mDigits, Other.Value)\nEnd Sub\n\nPublic Sub Subtract(ByVal Other As CBigNumber)\n    Dim b As String\n\n    b = Other.Value\n\n    If CompareAbs(mDigits, b) < 0 Then\n        mDigits = \"0\"\n    Else\n        mDigits = SubAbs(mDigits, b)\n    End If\nEnd Sub\n\n\nPrivate Function Normalize(ByVal s As String) As String\n    Dim i As Long\n    Dim ch As String\n\n    s = Trim$(s)\n\n    If Len(s) = 0 Then\n        Err.Raise vbObjectError + 1000, \"CBigNumber\", _\n                  \"Empty number\"\n    End If\n\n    For i = 1 To Len(s)\n        ch = Mid$(s, i, 1)\n\n        If ch < \"0\" Or ch > \"9\" Then\n            Err.Raise vbObjectError + 1001, \"CBigNumber\", _\n                      \"Invalid unsigned integer\"\n        End If\n    Next i\n\n    Do While Len(s) > 1 And Left$(s, 1) = \"0\"\n        s = Mid$(s, 2)\n    Loop\n\n    Normalize = s\nEnd Function\n\n' Compare non-negative integer strings.\n' Returns 1 if a > b, -1 if a < b, otherwise 0.\nPrivate Function CompareAbs(ByVal a As String, _\n                            ByVal b As String) As Integer\n\n    If Len(a) > Len(b) Then\n        CompareAbs = 1\n    ElseIf Len(a) < Len(b) Then\n        CompareAbs = -1\n    ElseIf a > b Then\n        CompareAbs = 1\n    ElseIf a < b Then\n        CompareAbs = -1\n    Else\n        CompareAbs = 0\n    End If\nEnd Function\n\n' Add two non-negative integer strings.\nPrivate Function AddAbs(ByVal a As String, _\n                        ByVal b As String) As String\n\n    Dim i As Long\n    Dim j As Long\n    Dim da As Long\n    Dim db As Long\n    Dim carry As Long\n    Dim digit As Long\n    Dim result As String\n\n    i = Len(a)\n    j = Len(b)\n\n    Do While i > 0 Or j > 0 Or carry > 0\n        da = 0\n        db = 0\n\n        If i > 0 Then\n            da = Asc(Mid$(a, i, 1)) - 48\n            i = i - 1\n        End If\n\n        If j > 0 Then\n            db = Asc(Mid$(b, j, 1)) - 48\n            j = j - 1\n        End If\n\n        digit = da + db + carry\n        carry = digit \\ 10\n        digit = digit Mod 10\n\n        result = Chr$(digit + 48) & result\n    Loop\n\n    AddAbs = result\nEnd Function\n\n\nPublic Sub AddPercent(ByVal Other As CBigNumber, ByVal f As Double)\n    Dim contribution As Double\n    Dim wholePart As Double\n    Dim fracPart As Double\n    Dim wholeString As String\n\n    If f < 0# Or f > 1# Then\n        Err.Raise vbObjectError + 1003, \"CBigNumber\", _\n                  \"Factor must be between 0 and 1\"\n    End If\n\n    ' Double cannot represent arbitrarily large integers exactly.\n    ' This approach is suitable when Other fits within Double precision.\n    contribution = CDbl(Other.mDigits) * f + Other.mFraction * f\n\n    wholePart = Fix(contribution)\n    fracPart = contribution - wholePart\n\n    wholeString = Format$(wholePart, \"0\")\n\n    mDigits = AddAbs(mDigits, wholeString)\n    mFraction = mFraction + fracPart\n\n    If mFraction >= 1# Then\n        mDigits = AddAbs(mDigits, \"1\")\n        mFraction = mFraction - 1#\n    End If\nEnd Sub\n\n' Subtract b from a. Requires a >= b.\nPrivate Function SubAbs(ByVal a As String, _\n                        ByVal b As String) As String\n\n    Dim i As Long\n    Dim j As Long\n    Dim da As Long\n    Dim db As Long\n    Dim borrow As Long\n    Dim digit As Long\n    Dim result As String\n\n    i = Len(a)\n    j = Len(b)\n\n    Do While i > 0\n        da = Asc(Mid$(a, i, 1)) - 48 - borrow\n        db = 0\n\n        If j > 0 Then\n            db = Asc(Mid$(b, j, 1)) - 48\n            j = j - 1\n        End If\n\n        If da < db Then\n            da = da + 10\n            borrow = 1\n        Else\n            borrow = 0\n        End If\n\n        digit = da - db\n        result = Chr$(digit + 48) & result\n\n        i = i - 1\n    Loop\n\n    Do While Len(result) > 1 And Left$(result, 1) = \"0\"\n        result = Mid$(result, 2)\n    Loop\n\n    SubAbs = result\nEnd Function\n\n\nPublic Function Display() As String\n    Dim names As Variant\n    Dim groupIndex As Long\n    Dim leadingDigits As Long\n    Dim leading As String\n    Dim fractional As String\n    Dim remainder As String\n\n    names = Array( _\n        \"\", \"thousand\", \"million\", \"billion\", _\n        \"trillion\", \"quadrillion\", \"quintillion\", _\n        \"sextillion\", \"septillion\", \"octillion\", _\n        \"nonillion\", \"decillion\", \"undecillion\", _\n        \"duodecillion\", \"tredecillion\", _\n        \"quattuordecillion\", \"quindecillion\", _\n        \"sexdecillion\", \"septendecillion\", _\n        \"octodecillion\", \"novemdecillion\", _\n        \"vigintillion\")\n\n    ' Below one million, show the full number.\n    If Len(mDigits) <= 6 Then\n        Display = mDigits\n        Exit Function\n    End If\n\n    groupIndex = (Len(mDigits) - 1) \\ 3\n    leadingDigits = Len(mDigits) - groupIndex * 3\n\n    leading = Left$(mDigits, leadingDigits)\n\n    ' Read the next two digits as the fractional part.\n    remainder = Mid$(mDigits, leadingDigits + 1, 2)\n\n    If Len(remainder) > 0 Then\n        remainder = remainder & String$(2 - Len(remainder), \"0\")\n    End If\n\n    If remainder <> \"\" Then\n        fractional = \".\" & remainder\n    Else\n        fractional = \"\"\n    End If\n\n    If groupIndex <= UBound(names) Then\n        Display = leading & fractional & \" \" & names(groupIndex)\n    Else\n        Display = leading & fractional & \" x 10^\" & _\n                  CStr(groupIndex * 3)\n    End If\nEnd Function\n\n\n",
      "bookmarks": []
    }
  ],
