      "id": "id_mvr47wcg_2h",
      "name": "Form1",
      "kind": "form",
      "code": "Option Explicit\n\nDim gScore as CBigNumber\nDim gBPS as CBigNumber\nDim gTickBPS as CBigNumber\n\nPrivate Sub UpdateScoreAndBPSLabel()\n    lblScore.Caption = gScore.Display()\n    lblBPS.Caption = \"processing rate: \" + gBPS.Display()\n    \nEnd Sub\n\n\nPrivate Sub Form_Load()\n    \n    Set gScore = new CBigNumber\n    Set gBPS = new CBigNumber\n    Set gTickBPS = new CBigNumber\n        \n    gScore.Value = \"0\"\n    gBPS.Value = \"1\"\n    gTickBPS.Value = \"0\"\n        \n    UpdateScoreAndBPSLabel()\nEnd Sub\n\nPrivate Sub CommandButton1_Click()\n    gTickBPS.Add(gBPS)\nEnd Sub\n\nPrivate Sub Timer1_Timer()\n    If Not gBPS.IsZero Then\n        gTickBPS.AddPercent(gBPS, 0.25)\n    End If\n    \n    gScore.Add(gTickBPS)\n    gTickBPS.Value = \"0\"\n    \n    UpdateScoreAndBPSLabel()\nEnd Sub\n",
